'use strict';
const WF={rows:[],modes:[],versions:[],current:null,selected:null,connect:null,errors:[],sim:null,simBusy:false,simError:'',zoom:1,loaded:false};
const wfTypes=['START','REVIEW','APPROVAL','DECISION','RETURN','ASSIGNMENT','NOTIFICATION','CLEAR_FOR_OUT','END'];
const wfUid=()=>crypto.randomUUID();
function wfIcon(type){const icons={START:'<circle cx="12" cy="12" r="10"/><path d="m10 7 7 5-7 5z" fill="currentColor" stroke="none"/>',REVIEW:'<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="8" r="3"/><path d="M6 19c.6-3 2.5-4.5 6-4.5s5.4 1.5 6 4.5"/>',APPROVAL:'<rect x="2" y="2" width="20" height="20" rx="5"/><path d="m6 12 4 4 8-9"/>',DECISION:'<path d="M12 1 23 12 12 23 1 12z"/><path d="M12 6v12M7 10l5-4 5 4M7 14l5 4 5-4"/>',RETURN:'<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M9 8 5 12l4 4M5 12h8a5 5 0 0 1 5 5"/>',ASSIGNMENT:'<rect x="2" y="2" width="20" height="20" rx="5"/><rect x="9" y="5" width="6" height="5" rx="1"/><rect x="4" y="15" width="6" height="5" rx="1"/><rect x="14" y="15" width="6" height="5" rx="1"/><path d="M12 10v2.5H7v2.5m5-2.5h5v2.5"/>',NOTIFICATION:'<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M7 16h10l-1.5-2.5V10a3.5 3.5 0 0 0-7 0v3.5zM10 19h4"/>',CLEAR_FOR_OUT:'<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M7 20V4m1 1h9l-2 3 2 3H8"/><path d="m12 14 2 2 4-4"/>',END:'<rect x="2" y="2" width="20" height="20" rx="5"/><rect x="8" y="8" width="8" height="8" rx="1" fill="currentColor" stroke="none"/>'};return '<svg viewBox="0 0 24 24" aria-hidden="true">'+icons[type]+'</svg>';}
function wfGraph(){const labels=['Document received','Admin Staff review','Focal / Supervisor review','Staff processing','Supervisor review','Division Manager review','Department Manager / acting approver','Clear for Out','Released / Out','Return for revision'];const types=['START','REVIEW','REVIEW','ASSIGNMENT','REVIEW','REVIEW','REVIEW','CLEAR_FOR_OUT','END','RETURN'];const roles=['','admin_staff','focal','','supervisor','div_manager','dept_manager','','',''];const nodes=labels.map((label,i)=>({id:'n'+i,type:types[i],label,x:30+i%5*240,y:80+Math.floor(i/5)*230,config:roles[i]?{responsibilityType:'ROLE',role:roles[i]}:(i===3||i===9?{responsibilityType:'CURRENT_ASSIGNEE'}:{})}));const pairs=[[0,1,'Received'],[1,2,'Forward'],[2,3,'Assign'],[3,4,'Submit'],[4,5,'Approve'],[5,6,'Approve'],[6,7,'Clear'],[7,8,'Log out'],[4,9,'Return'],[9,3,'Revise']];return{nodes,edges:pairs.map((p,i)=>({id:'e'+i,source:'n'+p[0],target:'n'+p[1],label:p[2],condition:{}}))};}
async function wfList(){const r=await api('GET','/api/workflows');if(r.ok){WF.rows=r.workflows||[];WF.modes=r.modes||[];WF.loaded=true;}}
function wfCreateDialog(convert){openModal(convert?'Convert existing workflow':'Create workflow','<div data-form="wfcreate"><div class="fld"><label>Workflow name</label><input name="name" value="'+(convert?'Existing document workflow':'')+'"></div><div class="fld"><label>Document type</label><select name="docType">'+S.refs.doc.map(x=>opt(x.name,x.name)).join('')+'</select></div></div>',{foot:'<button class="btn" data-act="closeModal">Cancel</button><button class="btn primary" data-act="wfCreate" data-convert="'+(convert?'1':'0')+'">Create draft</button>'});}
async function wfCreate(convert){const v=formVals($('[data-form="wfcreate"]'));if(!v.name||!v.docType)return toast('Name and document type are required.','bad');const r=await api('POST','/api/workflows',{name:v.name,docType:v.docType,definition:convert?wfGraph():{nodes:[],edges:[]}});if(!r.ok)return toast(r.error||'Could not create workflow.','bad');closeModal();WF.current=r.workflow;await wfList();render();}
async function wfOpen(id,version){const meta=await api('GET','/api/workflows/'+id);if(!meta.ok)return toast(meta.error||'Could not open workflow.','bad');WF.versions=meta.versions||[];const v=version||WF.versions[0]?.id,r=await api('GET','/api/workflows/'+id+'/versions/'+v);if(r.ok){WF.current=r.workflow;WF.selected=null;WF.errors=[];WF.sim=null;render();}else toast(r.error||'Could not open workflow version.','bad');}
function wfEditor(){const w=WF.current;if(!w)return '';const by=Object.fromEntries(w.nodes.map(n=>[n.id,n]));const lines=w.edges.map(e=>{const a=by[e.source],b=by[e.target];return a&&b?'<path d="M'+(a.x+190)+' '+(a.y+40)+' C'+((a.x+b.x)/2)+' '+(a.y+40)+' '+((a.x+b.x)/2)+' '+(b.y+40)+' '+b.x+' '+(b.y+40)+'" marker-end="url(#wfa)"/><text data-edge="'+esc(e.id)+'" x="'+((a.x+b.x)/2)+'" y="'+((a.y+b.y)/2-6)+'">'+esc(e.label||'')+'</text>':''}).join('');const nodes=w.nodes.map(n=>'<article class="wf-node wf-node-'+n.type.toLowerCase()+(WF.selected===n.id?' selected':'')+(WF.connect===n.id?' source':'')+'" data-wfn="'+esc(n.id)+'" style="left:'+n.x+'px;top:'+n.y+'px"><button data-act="wfSelect" data-id="'+esc(n.id)+'"><span class="wf-node-glyph">'+wfIcon(n.type)+'</span><span class="wf-node-copy"><small>'+esc(n.type.replaceAll('_',' '))+'</small><b>'+esc(n.label)+'</b></span></button><button class="wf-port" data-act="wfConnect" data-id="'+esc(n.id)+'">↗</button></article>').join('');const edges=w.edges.map(e=>'<div class="wf-edge-row"><span>'+esc((by[e.source]||{}).label||'?')+' → '+esc((by[e.target]||{}).label||'?')+'</span><input data-wfe="'+esc(e.id)+'" value="'+esc(e.label||'')+'" placeholder="Action" list="wfLegacyActions"><button data-act="wfDelEdge" data-id="'+esc(e.id)+'">×</button></div>').join('')+'<datalist id="wfLegacyActions"><option>Received</option><option>Forward</option><option>Assign</option><option>Submit</option><option>Approve</option><option>Clear</option><option>Log out</option><option>Return</option><option>Revise</option></datalist>';const selected=w.nodes.find(n=>n.id===WF.selected);const props=selected?'<button class="btn sm" data-act="wfDuplicate" data-id="'+esc(selected.id)+'">Duplicate node</button><button class="btn sm danger" data-act="wfDelNode" data-id="'+esc(selected.id)+'">Delete</button><div class="fld"><label>Type</label><select data-wfc="type" data-id="'+esc(selected.id)+'">'+wfTypes.map(t=>opt(t,t,selected.type===t)).join('')+'</select></div><div class="fld"><label>Name</label><input data-wfc="label" data-id="'+esc(selected.id)+'" value="'+esc(selected.label)+'"></div>'+(['REVIEW','APPROVAL','ASSIGNMENT'].includes(selected.type)?'<div class="fld"><label>Responsible role</label><select data-wfc="role" data-id="'+esc(selected.id)+'">'+Object.entries(ROLES).filter(x=>x[0]!=='sysadmin').map(x=>opt(x[0],x[1],(selected.config||{}).role===x[0])).join('')+'</select></div>':''): '<p class="hint">Select a node. Drag to move; connect with ↗.</p>';const terminal=WF.sim&&WF.sim.path?'<div class="card pad"><h3>Read-only simulation</h3><ol>'+WF.sim.path.map(x=>'<li>'+esc(x.label)+'</li>').join('')+'</ol><p>'+(WF.sim.terminated?'Workflow reaches an end node.':'Workflow did not reach an end node.')+'</p></div>':'';return '<section class="wf-editor"><header class="wf-toolbar"><div><b>'+esc(w.name)+'</b> '+badge(w.status==='PUBLISHED'?'ok':'warn',w.status+' · v'+w.version)+'<div class="hint">'+esc(w.docType)+'</div></div><div class="row"><button class="btn" data-act="wfSave" '+(w.status==='PUBLISHED'?'disabled':'')+'>Save draft</button><button class="btn" data-act="wfValidate">Validate</button><button class="btn" data-act="wfSim">'+(WF.simBusy?'Simulating…':'Test / Simulate')+'</button>'+(w.status==='PUBLISHED'?'<button class="btn primary" data-act="wfFork">New draft</button>':'<button class="btn primary" data-act="wfPublish">Publish</button>')+'</div></header><div class="wf-layout"><aside class="wf-palette"><b>Node palette</b>'+wfTypes.map(t=>'<button class="btn sm wf-palette-add" data-act="wfAdd" data-type="'+t+'"><span class="wf-palette-icon wf-icon-'+t.toLowerCase()+'">'+wfIcon(t)+'</span><span>'+t.replaceAll('_',' ')+'</span></button>').join('')+'<hr><b>Connections</b>'+edges+'</aside><div class="wf-board" id="wfBoard"><div class="wf-scene" id="wfScene" style="transform:scale('+WF.zoom+')"><svg class="wf-lines" width="2400" height="1200"><defs><marker id="wfa" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0 L0 6 L7 3z" fill="currentColor"/></marker></defs>'+lines+'</svg>'+nodes+'</div><div class="wf-canvas-controls"><button class="btn sm" data-act="wfZoomOut">−</button><span>'+Math.round(WF.zoom*100)+'%</span><button class="btn sm" data-act="wfZoomIn">＋</button><button class="btn sm" data-act="wfFit">⛶</button></div></div><aside class="wf-properties"><b>Node properties</b>'+props+'</aside></div>'+(WF.errors.length?'<div class="banner bad"><b>Validation issues</b><ul>'+WF.errors.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul></div>':'')+(WF.simError?'<div class="banner bad">'+esc(WF.simError)+'</div>':'')+terminal+'</section>';}

VIEWS.workflow=function(u){if(!u||u.role!=='sysadmin')return '<div class="wrap"><div class="card empty">You do not have access to workflow administration.</div></div>';if(!WF.loaded)wfList().then(()=>render());return '<div class="wrap wf-full"><div class="pagehead"><div><h1>Workflow Engine</h1><p>Design, validate, simulate and version workflows.</p></div><div class="row"><button class="btn" data-act="wfNew">Create workflow</button><button class="btn primary" data-act="wfConvert">Convert existing workflow</button></div></div>'+wfEditor()+'</div>';};
document.addEventListener('click',async ev=>{const t=ev.target.closest('[data-act]');if(!t||UI.route!=='workflow')return;const a=t.dataset.act,w=WF.current,id=t.dataset.id;if(a==='wfZoomIn'){WF.zoom=Math.min(1.5,WF.zoom+.1);render();return;}if(a==='wfZoomOut'){WF.zoom=Math.max(.4,WF.zoom-.1);render();return;}if(a==='wfFit'){WF.zoom=.8;render();return;}if(a==='wfNew')wfCreateDialog(false);if(a==='wfConvert')wfCreateDialog(true);if(a==='wfCreate')wfCreate(t.dataset.convert==='1');if(a==='wfOpen')wfOpen(id,t.dataset.version);if(a==='wfSelect'){WF.selected=id;render();}if(a==='wfConnect'){if(wfSuppressPortClick){wfSuppressPortClick=false;return;}return;}if(a==='wfAdd'){const type=t.dataset.type,n={id:wfUid(),type,label:type.replaceAll('_',' '),x:60+w.nodes.length%4*230,y:60+Math.floor(w.nodes.length/4)*150,config:{}};if(['REVIEW','APPROVAL','ASSIGNMENT'].includes(type))n.config={responsibilityType:'ROLE',role:'admin_staff'};w.nodes.push(n);WF.selected=n.id;render();}if(a==='wfDuplicate'){const n=JSON.parse(JSON.stringify(w.nodes.find(x=>x.id===id)));n.id=wfUid();n.label+=' copy';n.x+=35;n.y+=35;w.nodes.push(n);WF.selected=n.id;render();}if(a==='wfDelNode'){w.nodes=w.nodes.filter(n=>n.id!==id);w.edges=w.edges.filter(e=>e.source!==id&&e.target!==id);WF.selected=null;render();}if(a==='wfDelEdge'){w.edges=w.edges.filter(e=>e.id!==id);render();}if(a==='wfFork'){const r=await api('POST','/api/workflows/'+w.id+'/versions/'+w.versionId+'/fork',{});if(r.ok){await wfList();await wfOpen(w.id,r.workflow.versionId);}else toast(r.error||'Could not create a draft version.','bad');}if(a==='wfSim'){WF.simBusy=true;WF.sim=null;WF.simError='';render();try{const saved=await api('PUT','/api/workflows/'+w.id+'/versions/'+w.versionId,{name:w.name,docType:w.docType,definition:{nodes:w.nodes,edges:w.edges}});if(!saved.ok)throw new Error(saved.error||'Could not save draft.');WF.current=saved.workflow;const r=await api('POST','/api/workflows/'+w.id+'/versions/'+w.versionId+'/simulate',{documentId:''});if(r.ok)WF.sim=r;else WF.simError=r.error||'Simulation failed.';}catch(err){WF.simError=err.message||'Simulation failed.';}WF.simBusy=false;render();return;}if(a==='wfSave'||a==='wfValidate'||a==='wfPublish'){const saved=await api('PUT','/api/workflows/'+w.id+'/versions/'+w.versionId,{name:w.name,docType:w.docType,definition:{nodes:w.nodes,edges:w.edges}});if(!saved.ok)return toast(saved.error||'Could not save workflow.','bad');WF.current=saved.workflow;if(a==='wfSave'){render();return toast('Draft saved.');}const r=await api('POST','/api/workflows/'+w.id+'/versions/'+w.versionId+(a==='wfValidate'?'/validate':'/publish'),{});WF.errors=r.errors||[];if(r.ok&&a==='wfPublish'){WF.current=r.workflow;await wfList();}render();toast(WF.errors.length?'Validation found issues.':a==='wfValidate'?'Workflow is valid.':'Workflow published.',WF.errors.length?'bad':'');}});
document.addEventListener('input',ev=>{const t=ev.target;if(!WF.current)return;if(t.matches('[data-wfe]')){const e=WF.current.edges.find(x=>x.id===t.dataset.wfe);if(e)e.label=t.value;const label=document.querySelector('.wf-lines text[data-edge="'+CSS.escape(t.dataset.wfe)+'"]');if(label)label.textContent=t.value;}if(t.matches('[data-wfc="label"]')){const n=WF.current.nodes.find(x=>x.id===t.dataset.id);if(n)n.label=t.value;}if(t.matches('[data-wfc="role"]')){const n=WF.current.nodes.find(x=>x.id===t.dataset.id);if(n){n.config=n.config||{};n.config.responsibilityType='ROLE';n.config.role=t.value;}}if(t.matches('[data-wfc="type"]')){const n=WF.current.nodes.find(x=>x.id===t.dataset.id);if(n){n.type=t.value;if(['REVIEW','APPROVAL','ASSIGNMENT'].includes(n.type)){n.config=n.config||{};n.config.responsibilityType='ROLE';n.config.role=n.config.role||'admin_staff';}}}});
const oldRefresh=refresh;refresh=async function(...args){const ok=await oldRefresh(...args);if(ok&&UI.route==='workflow')await wfList();return ok;};

let wfDrag=null,wfPortDrag=null,wfSuppressPortClick=false;document.addEventListener('pointerdown',ev=>{const port=ev.target.closest('.wf-port');if(port&&WF.current){wfPortDrag={source:port.closest('.wf-node').dataset.wfn};ev.preventDefault();return;}const el=ev.target.closest('.wf-node');if(!el||ev.target.closest('.wf-port'))return;const n=WF.current&&WF.current.nodes.find(x=>x.id===el.dataset.wfn);if(n)wfDrag={n,x:ev.clientX,y:ev.clientY,ox:n.x,oy:n.y};});document.addEventListener('pointermove',ev=>{if(wfPortDrag){const board=document.querySelector('#wfBoard'),svg=document.querySelector('.wf-lines'),src=WF.current&&WF.current.nodes.find(n=>n.id===wfPortDrag.source);if(board&&svg&&src){svg.querySelector('.wf-connecting')?.remove();const rect=board.getBoundingClientRect(),x=(ev.clientX-rect.left+board.scrollLeft)/WF.zoom,y=(ev.clientY-rect.top+board.scrollTop)/WF.zoom,x1=src.x+190,y1=src.y+40,m=(x+x1)/2;svg.insertAdjacentHTML('beforeend','<path class="wf-connecting" d="M'+x1+' '+y1+' C'+m+' '+y1+' '+m+' '+y+' '+x+' '+y+'"/>');}return;}if(!wfDrag)return;wfDrag.n.x=Math.max(0,wfDrag.ox+(ev.clientX-wfDrag.x)/WF.zoom);wfDrag.n.y=Math.max(0,wfDrag.oy+(ev.clientY-wfDrag.y)/WF.zoom);const e=document.querySelector('[data-wfn="'+CSS.escape(wfDrag.n.id)+'"]');if(e){e.style.left=wfDrag.n.x+'px';e.style.top=wfDrag.n.y+'px';}const svg=document.querySelector('.wf-lines');if(svg&&WF.current){const by=Object.fromEntries(WF.current.nodes.map(n=>[n.id,n]));svg.querySelectorAll('path:not(marker path)').forEach((path,i)=>{const edge=WF.current.edges[i],a=edge&&by[edge.source],b=edge&&by[edge.target];if(a&&b){const m=(a.x+190+b.x)/2;path.setAttribute('d','M'+(a.x+190)+' '+(a.y+40)+' C'+m+' '+(a.y+40)+' '+m+' '+(b.y+40)+' '+b.x+' '+(b.y+40));}});}});document.addEventListener('pointerup',ev=>{if(wfPortDrag){const target=ev.target.closest('.wf-node'),dest=target&&target.dataset.wfn,src=wfPortDrag.source;if(dest&&dest!==src){WF.current.edges.push({id:wfUid(),source:src,target:dest,label:'',condition:{}});wfSuppressPortClick=true;setTimeout(()=>wfSuppressPortClick=false,0);render();}else document.querySelector('.wf-connecting')?.remove();wfPortDrag=null;}wfDrag=null;});

document.addEventListener('change',ev=>{if(ev.target.matches('[data-wfc]'))render();});
